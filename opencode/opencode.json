{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "share": "disabled",
  "enabled_providers": ["home"],
  "model": "home/qwen3.8:27b",
  "small_model": "home/qwen3.8:27b",
  "provider": {
    "home": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Desktop Ollama (SSH)",
      "options": {
        "baseURL": "http://127.0.0.1:11435/v1"
      },
      "models": {
        "qwen3.8:27b": {
          "name": "Qwen 3.8 27B (desktop)",
          "attachment": true,
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"]
          },
          "limit": { "context": 32768, "output": 8192 }
        }
      }
    }
  },
  "permission": {
    "*": "ask",
    "webfetch": "deny",
    "websearch": "deny"
  }
}
